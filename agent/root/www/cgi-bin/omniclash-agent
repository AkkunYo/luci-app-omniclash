#!/usr/bin/ucode
/*
 * OmniClash Agent - 子 AP 侧轻量控制端点
 *
 * 由 uhttpd 以 CGI 方式调用：
 *   POST /cgi-bin/omniclash-agent
 *   Header: Authorization: Bearer <token>
 *   Body:   {"method":"<name>","params":{...}}
 *
 * 安全边界（不可放宽）：
 *   - 只读写本机 wireless uci，绝不触碰 network / dhcp / firewall
 *   - 绝不执行 network reload / reboot / wifi down，只用 wifi reload
 *   - 不提供任何通用命令执行入口，不接受 shell 字符串
 *   - 每次写盘前把 wireless 备份到 /etc/omniclash-agent/wireless.bak
 */

import { stdin, stdout, readfile, writefile, access, popen, lsdir, mkdir, unlink } from 'fs';

function shell_exec(cmd) {
	let p = popen(cmd);
	if (!p) return { code: -1, out: '' };
	let out = p.read('all') || '';
	let code = p.close();
	return { code: code, out: out };
}

const VERSION = '0.1.0';
const STATE_DIR = '/etc/omniclash-agent';
const TOKEN_FILE = STATE_DIR + '/token';
const BACKUP_FILE = STATE_DIR + '/wireless.bak';
const ALLOWED_ENC = [
	'none', 'psk', 'psk2', 'psk-mixed', 'sae', 'sae-mixed',
	'psk2+ccmp', 'psk-mixed+ccmp', 'wpa2', 'wpa3', 'wpa3-mixed'
];

let uci = require('uci').cursor();

/* ---------------- 输出 ---------------- */

function out(obj) {
	stdout.write("Content-Type: application/json\r\n");
	stdout.write("Cache-Control: no-store\r\n\r\n");
	stdout.write(sprintf('%J', obj));
}

function fail(msg) {
	out({ ok: false, error: msg });
	exit(0);
}

function ok(extra) {
	let r = { ok: true };
	if (type(extra) == 'object') {
		for (let k in keys(extra))
			r[k] = extra[k];
	}
	return r;
}

/* ---------------- 工具 ---------------- */

function file_trim(path) {
	let v = readfile(path);
	if (v == null) return null;
	return trim(sprintf('%s', v));
}

function token_of() {
	let t = file_trim(TOKEN_FILE);
	return (t && length(t) >= 8) ? t : null;
}

/* 恒定时间比较，避免通过响应时间推断 token 前缀 */
function token_equal(a, b) {
	if (type(a) != 'string' || type(b) != 'string') return false;
	let la = length(a), lb = length(b);
	if (la != lb) return false;
	let diff = 0;
	for (let i = 0; i < la; i++)
		diff = diff | (ord(substr(a, i, 1)) ^ ord(substr(b, i, 1)));
	return diff == 0;
}

/* ---------------- 参数校验 ---------------- */

function valid_section(s) {
	if (type(s) != 'string') return false;
	return match(s, /^[a-z0-9_]{1,32}$/) ? true : false;
}

function valid_ssid(s) {
	if (type(s) != 'string') return false;
	if (length(s) == 0) return false;
	/* SSID 上限 32 字节 */
	return length(s) <= 32;
}

function valid_psk(s) {
	if (type(s) != 'string') return false;
	if (length(s) == 0) return true;       /* 开放网络 */
	return length(s) <= 63 && length(s) >= 8;
}

function valid_disabled(v) {
	return (v == true || v == false || v == 0 || v == 1 ||
		v == '0' || v == '1' || v == null);
}

function as_flag(v) {
	if (v == true || v == 1 || v == '1') return '1';
	return '0';
}

/* ---------------- wireless 读写 ---------------- */

/* ucode 的 uci cursor 没有"取整个 section"的方法，只能逐项 get 或通过
 * foreach 收集。这里统一构造一次 section 快照，避免反复调用 foreach。 */
function snapshot_wireless() {
	let map = {};
	uci.foreach('wireless', 'wifi-iface', function (s) {
		let name = s['.name'];
		if (!name) return;
		let obj = {};
		for (let k in keys(s))
			if (k != '.name' && k != '.type')
				obj[k] = s[k];
		map[name] = obj;
	});
	return map;
}

function is_ap_iface(snap, sec) {
	let s = snap[sec];
	if (type(s) != 'object') return false;
	if (s.mode == null) return true;
	return (s.mode == 'ap');
}

function list_ap_sections() {
	let arr = [];
	uci.foreach('wireless', 'wifi-iface', function(s) {
		if (s['.name']) push(arr, s['.name']);
	});
	sort(arr);
	return arr;
}

function backup_wireless() {
	let p = popen('uci export wireless 2>/dev/null');
	if (!p) return false;
	let data = p.read('all') || '';
	p.close();
	if (!data) return false;
	writefile(BACKUP_FILE, data);
	return true;
}

/* 一次性抓取所有接口的 SSID 与客户端数。
 * 早期实现每个 section 都 fork 一次 `iw dev ... station dump`，
 * 25 个接口要 5 秒；这里合并成一次 shell 调用。 */
function collect_clients() {
	let map = {};

	let p = popen("iw dev 2>/dev/null | awk '/^phy#/{phy=$0} /^\\tInterface/{print $2}'");
	let ifaces = [];
	if (p) {
		let txt = p.read('all') || '';
		p.close();
		for (let line in split(txt, '\n')) {
			let t = trim(line);
			if (t) push(ifaces, t);
		}
	}

	/* 单次调用：对每个接口输出 "iface<TAB>ssid<TAB>count" */
	let cmd = "for d in " + join(" ", ifaces) + "; do "
		+ "s=$(iw dev $d info 2>/dev/null | awk '/^\\tssid/{print $2}'); "
		+ "c=$(iw dev $d station dump 2>/dev/null | grep -c '^Station'); "
		+ "echo \"$d|$s|$c\"; "
		+ "done";

	if (length(ifaces) > 0) {
		let q = popen(cmd);
		if (q) {
			let out = q.read('all') || '';
			q.close();
			for (let line in split(out, '\n')) {
				let parts = split(trim(line), "|");
				if (length(parts) != 3) continue;
				let ssid = parts[1];
				if (!ssid) continue;
				map[ssid] = (map[ssid] || 0) + int(parts[2]);
			}
		}
	}

	return map;
}

function phy_limits() {
	let res = { '2g': 16, '5g': 16 };

	/* 每个 phy 的 AP 上限；解析 "valid interface combinations" 里的
	 * "#{ AP } <= N" 片段。取不到时保持保守默认 16。 */
	for (let idx in ['phy0', 'phy1']) {
		let q = popen(sprintf("iw phy %s info 2>/dev/null | tr '\\n' ' ' | grep -o '#{[^}]*AP[^}]*} *<= *[0-9]*' | head -1", idx));
		if (!q) continue;
		let info = q.read('all') || '';
		q.close();
		let m = match(info, /<=\s*([0-9]+)/);
		if (!m) continue;
		let lim = int(m[1]);
		if (lim <= 0) continue;
		if (idx == 'phy0') res['2g'] = lim;
		else res['5g'] = lim;
	}

	return res;
}

/* ---------------- methods ---------------- */

function m_ping(p, authed) {
	return out({
		ok: true,
		version: VERSION,
		hostname: file_trim('/proc/sys/kernel/hostname') || '',
		board: file_trim('/tmp/sysinfo/board_name') || file_trim('/tmp/sysinfo/model') || '',
		token_ok: authed
	});
}

function m_get_wifi(p) {
	let snap = snapshot_wireless();
	let clients = collect_clients();
	let ifaces = [];
	for (let sec in list_ap_sections()) {
		let s = snap[sec] || {};
		push(ifaces, {
			section: sec,
			ssid: s.ssid || '',
			key: s.key || '',
			network: s.network || '',
			device: s.device || '',
			disabled: (s.disabled == '1'),
			mode: s.mode || 'ap',
			encryption: s.encryption || '',
			clients: clients[s.ssid || ''] || 0
		});
	}
	return out({
		ok: true,
		interfaces: ifaces,
		limits: phy_limits(),
		phys: []
	});
}

/* 单条写入，返回 changed 布尔；校验失败直接 fail */
function apply_one(snap, item) {
	if (type(item) != 'object') fail('item must be an object');
	if (!valid_section(item.section)) fail('invalid section: ' + sprintf('%J', item.section));

	let sec = item.section;
	if (type(snap[sec]) != 'object')
		fail('unknown wireless section: ' + sec);
	if (!is_ap_iface(snap, sec))
		fail('section is not an ap interface: ' + sec);

	if (item.ssid != null && !valid_ssid(item.ssid))
		fail('invalid ssid for ' + sec + ' (must be 1..32 bytes)');
	if (item.key != null && !valid_psk(item.key))
		fail('invalid psk for ' + sec + ' (must be empty or 8..63 bytes)');
	if (item.encryption != null) {
		if (type(item.encryption) != 'string')
			fail('invalid encryption for ' + sec);
		let found = false;
		for (let e in ALLOWED_ENC)
			if (e == item.encryption) { found = true; break; }
		if (!found) fail('unsupported encryption: ' + item.encryption);
	}
	if (item.disabled != null && !valid_disabled(item.disabled))
		fail('invalid disabled flag for ' + sec);
	if (item.network != null && type(item.network) != 'string')
		fail('invalid network for ' + sec);

	let cur = snap[sec] || {};
	let changed = false;

	function put(opt, val) {
		if (val == null) return;
		if (cur[opt] == val) return;
		uci.set('wireless', sec, opt, val);
		cur[opt] = val;
		changed = true;
	}

	put('ssid', item.ssid);
	put('key', item.key);
	put('network', item.network);
	put('encryption', item.encryption);
	if (item.disabled != null) put('disabled', as_flag(item.disabled));

	return changed;
}

function m_set_wifi(p) {
	let guard = (p.guard != false) ? true : false;
	let snap = snapshot_wireless();

	/* 防自锁：拒绝改动 AC 当前所连的 SSID（除非显式 guard:false） */
	if (guard && p.current_ssid && p.ssid && p.ssid != p.current_ssid) {
		let cur = snap[p.section] || {};
		if (cur.ssid == p.current_ssid)
			fail('refusing to change the SSID this controller is connected through (pass guard:false to override)');
	}

	backup_wireless();
	let changed = apply_one(snap, p);
	if (changed)
		uci.commit('wireless');

	if (changed && p.reload != false) {
		let q = popen('wifi reload >/dev/null 2>&1');
		if (q) q.close();
	}

	return out({ ok: true, changed: changed });
}

function m_bulk_set_wifi(p) {
	if (type(p.items) != 'array')
		fail('items must be an array');
	if (length(p.items) == 0)
		return out({ ok: true, applied: 0, failed: [] });

	let snap = snapshot_wireless();

	/* 先全量校验：任一项非法则整批拒绝，不写盘 */
	for (let it in p.items) {
		if (type(it) != 'object') fail('items must be objects');
		if (!valid_section(it.section)) fail('invalid section: ' + sprintf('%J', it.section));
		if (type(snap[it.section]) != 'object')
			fail('unknown wireless section: ' + sprintf('%J', it.section));
		if (it.ssid != null && !valid_ssid(it.ssid)) fail('invalid ssid for ' + it.section);
		if (it.key != null && !valid_psk(it.key)) fail('invalid psk for ' + it.section);
		if (it.disabled != null && !valid_disabled(it.disabled)) fail('invalid disabled flag for ' + it.section);
	}

	backup_wireless();

	let applied = 0;
	for (let it in p.items) {
		if (apply_one(snap, it)) applied++;
	}

	if (applied > 0)
		uci.commit('wireless');

	if (applied > 0 && p.reload != false) {
		let q = popen('wifi reload >/dev/null 2>&1');
		if (q) q.close();
	}

	return out({ ok: true, applied: applied, failed: [] });
}

function m_reload_wifi(p) {
	if (p.dry_run == true)
		return out({ ok: true, dry_run: true });
	let q = popen('wifi reload >/dev/null 2>&1');
	if (q) q.close();
	return out({ ok: true });
}

/* 在 agent 本机创建/更新 wifi-iface 段。
 *
 * 只写 wireless，不建 VLAN（VLAN 属于 network，留在 AC 侧做，
 * 或者由用户在 AP 上自行管理）。这样即使 agent 出错，AP 的
 * 三层网络也不会被破坏——最多是某个 SSID 消失，SSH/HTTP 仍在。 */
function m_provision_wifi(p) {
	if (type(p.items) != 'array')
		fail('items must be an array');
	if (length(p.items) == 0)
		return out({ ok: true, applied: 0, failed: [] });

	let snap = snapshot_wireless();

	/* 全量校验：section 名合法、射频存在、参数合规 */
	for (let it in p.items) {
		if (type(it) != 'object') fail('items must be objects');
		if (!valid_section(it.section)) fail('invalid section: ' + sprintf('%J', it.section));
		if (!valid_ssid(it.ssid)) fail('invalid ssid for ' + it.section);
		if (it.key != null && !valid_psk(it.key)) fail('invalid psk for ' + it.section);
		if (it.device != null && !valid_section(it.device)) fail('invalid device for ' + it.section);

		/* 已存在的段必须是 ap 模式，避免误改 usteer/中继等特殊段 */
		if (snap[it.section] && !is_ap_iface(snap, it.section))
			fail('section exists and is not an ap interface: ' + it.section);
	}

	backup_wireless();

	let applied = 0;
	for (let it in p.items) {
		let sec = it.section;
		let is_new = (snap[sec] == null);

		if (is_new)
			uci.set('wireless', sec, 'wifi-iface');

		uci.set('wireless', sec, 'mode', 'ap');
		if (it.device != null) uci.set('wireless', sec, 'device', it.device);
		if (it.network != null) uci.set('wireless', sec, 'network', it.network);
		uci.set('wireless', sec, 'ssid', it.ssid);
		if (it.key != null) {
			uci.set('wireless', sec, 'key', it.key);
			uci.set('wireless', sec, 'encryption', it.key ? 'psk2' : 'none');
		}
		uci.set('wireless', sec, 'disabled', as_flag(it.disabled));
		if (it.wmm != null) uci.set('wireless', sec, 'wmm', as_flag(it.wmm));

		applied++;
	}

	uci.commit('wireless');

	if (p.reload != false) {
		let q = popen('wifi reload >/dev/null 2>&1');
		if (q) q.close();
	}

	return out({ ok: true, applied: applied, failed: [] });
}

function m_restore_wifi(p) {
	if (!access(BACKUP_FILE))
		fail('no backup available');
	let data = readfile(BACKUP_FILE) || '';
	if (!data)
		fail('backup is empty');
	let q = popen('uci import wireless < ' + BACKUP_FILE);
	if (q) q.close();
	let r = popen('uci commit wireless && wifi reload >/dev/null 2>&1');
	if (r) r.close();
	return out({ ok: true });
}

/* ---------------- 网络配置快照 / 回滚 ----------------
 *
 * 全量 32 槽位架构需要在 AP 上建 VLAN（属于 network 段），这一步天然比
 * 只改 wireless 危险。因此提供显式快照与回滚：调用方必须先 backup，
 * 一旦 reload 把管理通道打断，可以在 AP 本地或串口上 restore 回来。 */

const SNAP_DIR = STATE_DIR + '/snapshots';

/* ucode 的 mkdir 只建一层，逐级创建 */
function ensure_dir(path) {
	let parts = split(path, '/');
	let cur = '';
	for (let p in parts) {
		if (p == '') { cur = '/'; continue; }
		cur = (cur == '/') ? ('/' + p) : (cur ? cur + '/' + p : p);
		if (!access(cur)) mkdir(cur);
	}
}

function snap_name(tag) {
	let safe = trim(sprintf('%s', tag || 'manual'));
	safe = replace(safe, /[^a-zA-Z0-9_-]/g, '_');
	return sprintf('%s/%s-%d', SNAP_DIR, safe, time());
}

function m_backup_config(p) {
	let dir = snap_name(p.tag || 'manual');
	ensure_dir(SNAP_DIR);
	ensure_dir(dir);

	for (let sec in ['network', 'dhcp', 'firewall', 'wireless']) {
		let q = popen(sprintf('uci export %s > %s/%s.uci 2>/dev/null', sec, dir, sec));
		if (q) q.close();
	}

	/* 记录当前管理地址，便于判断 reload 后是否还能回来 */
	let ip = popen("ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}'");
	if (ip) {
		let v = trim(ip.read('all') || '');
		ip.close();
		writefile(dir + '/mgmt.txt', v);
	}

	return out({ ok: true, dir: dir });
}

function m_restore_config(p) {
	let dir = p.dir;
	if (type(dir) != 'string' || !match(dir, /^\/etc\/omniclash-agent\/snapshots\/[a-zA-Z0-9_-]+$/))
		fail('invalid snapshot dir');

	for (let sec in ['wireless', 'network', 'dhcp', 'firewall']) {
		let f = sprintf('%s/%s.uci', dir, sec);
		if (!access(f)) continue;
		let q = popen(sprintf('uci import %s < %s', sec, f));
		if (q) q.close();
		let c = popen(sprintf('uci commit %s', sec));
		if (c) c.close();
	}

	return out({ ok: true, restored: dir });
}

function m_list_snapshots(p) {
	let arr = [];
	let d = lsdir(SNAP_DIR);
	for (let name in (d || [])) {
		if (match(name, /\./)) continue;
		push(arr, name);
	}
	sort(arr);
	return out({ ok: true, snapshots: arr });
}

/* ---------------- VLAN 桥接配置（只写不生效） ----------------
 *
 * 纯 AP 场景下每个 SSID 需要一个 `br-lan.<vid>` 桥接设备并挂到
 * `proto='none'` 的接口上，AP 自身不做三层。这属于 network 段，
 * 是整套方案里唯一可能影响管理通道的部分，因此严格分两步：
 *
 *   provision_vlan_config  只写 UCI + commit，绝不 reload —— 运行态不变，
 *                          管理链接 100% 不受影响。
 *   apply_network          显式二次确认后才 reload。调用方必须告知用户
 *                          "网络会短暂中断"，并优先在本地/串口执行。
 *
 * 缺失的 VLAN 不会被自动补齐到运行态，就是刻意设计：宁可某个 SSID 暂时
 * 不通，也不能让管理通道消失。 */

function existing_vlan_ids() {
	let ids = {};
	uci.foreach('network', 'interface', function (s) {
		let m = match(s['.name'] || '', /^vlan([0-9]+)$/);
		if (m) ids[int(m[1])] = true;
	});
	return ids;
}

/* 记录"变更前"快照的指针。
 *
 * 关键顺序：快照必须在写入之前拍。若在 apply_network 里才拍，拍到的就是
 * 已经改过的状态，回滚等于什么都没做。因此 provision_vlan_config 在动
 * UCI 之前先拍快照并写下指针，apply_network 只消费这个指针。 */
const PRECHG_FILE = STATE_DIR + '/pre-change-snapshot';

function take_prechange_snapshot(tag) {
	let dir = snap_name(tag || 'pre-change');
	ensure_dir(SNAP_DIR);
	ensure_dir(dir);

	for (let sec in ['network', 'dhcp', 'firewall', 'wireless']) {
		let q = popen(sprintf('uci export %s > %s/%s.uci 2>/dev/null', sec, dir, sec));
		if (q) q.close();
	}
	let cp = popen(sprintf('cp -f /etc/config/network %s/network.bak 2>/dev/null', dir));
	if (cp) cp.close();

	writefile(PRECHG_FILE, dir);
	return dir;
}

function latest_prechange() {
	/* 指针只在"有未确认变更"时才有意义：
	 *   - confirm_network 成功后会被删除（状态已更新，旧快照作废）
	 *   - 回滚执行后状态回到快照，指针仍可安全复用（它记录的正是当前值） */
	if (access(PRECHG_FILE)) {
		let d = trim(readfile(PRECHG_FILE) || '');
		if (match(d, /^\/etc\/omniclash-agent\/snapshots\/[a-zA-Z0-9_-]+$/) && access(d + '/network.uci'))
			return d;
	}
	return null;
}

function m_vlan_status(p) {
	let have = existing_vlan_ids();

	/* 哪些 wifi-iface 指向了不存在的 network 段 */
	let snap = snapshot_wireless();
	let dangling = [];
	for (let sec in keys(snap)) {
		let net = snap[sec].network;
		if (!net || net == 'lan') continue;
		let parts = split(net, ' ');
		for (let n in parts) {
			if (!uci.get('network', n))
				push(dangling, { section: sec, network: n });
		}
	}

	let present = [];
	for (let i = 101; i <= 132; i++)
		if (have[i]) push(present, i);

	return out({ ok: true, present: present, dangling: dangling });
}

function m_provision_vlan_config(p) {
	if (type(p.vlans) != 'array')
		fail('vlans must be an array');

	let want = [];
	for (let v in p.vlans) {
		let n = int(v);
		if (n < 1 || n > 4094) fail('vlan id out of range: ' + sprintf('%J', v));
		push(want, n);
	}

	let have = existing_vlan_ids();
	let created = [];

	/* 真正要写之前才拍快照，且只拍一次（指针存在就复用） */
	let snap = null;
	for (let n in want)
		if (!have[n]) { snap = latest_prechange() || take_prechange_snapshot('pre-vlan'); break; }

	for (let n in want) {
		if (have[n]) continue;

		let dev = sprintf('br_vlan%d', n);
		let ifc = sprintf('vlan%d', n);

		uci.set('network', dev, 'device');
		uci.set('network', dev, 'name', sprintf('br-vlan%d', n));
		uci.set('network', dev, 'type', 'bridge');
		uci.set('network', dev, 'ports', sprintf('br-lan.%d', n));

		uci.set('network', ifc, 'interface');
		uci.set('network', ifc, 'proto', 'none');
		uci.set('network', ifc, 'device', sprintf('br-vlan%d', n));

		push(created, n);
	}

	/* commit 只落盘，不影响运行态；真正生效必须显式 apply_network */
	if (length(created) > 0)
		uci.commit('network');

	return out({
		ok: true,
		created: created,
		pending_apply: length(created) > 0,
		rollback_dir: snap
	});
}

function m_apply_network(p) {
	/* 二次确认，防止误触发把管理通道打断 */
	if (p.confirm != 'APPLY_NETWORK') {
		fail('refusing to reload network without confirm="APPLY_NETWORK"; management link may drop');
	}

	if (p.dry_run == true)
		return out({ ok: true, dry_run: true });

	let grace = int(p.grace_sec || 90);
	if (grace < 30) grace = 30;
	if (grace > 600) grace = 600;

	/* 变更前快照必须已经存在（由 provision_vlan_config 或显式 backup 拍下）。
	 * 若没有，退化为"现在拍"，但那已经包含待生效的改动，回滚价值有限，
	 * 因此显式告知调用方。 */
	let snap = latest_prechange();
	let snap_source = 'pre-change';
	if (!snap) {
		snap = take_prechange_snapshot('pre-apply');
		snap_source = 'taken-at-apply (may already include pending changes)';
	}

	let confirm_file = '/tmp/omniclash_agent_net_ok';
	unlink(confirm_file);

	/* 整个看门狗是自包含脚本：先 reload，再等 grace，再判定。
	 * 用 start-stop-daemon -b 脱离 CGI 生命周期（OpenWrt 无 nohup），
	 * 这样 AC 断开、甚至 AC 关机都不影响它跑完。 */
	let script = sprintf(
		"sleep 1; /etc/init.d/network reload >/dev/null 2>&1; "
		+ "sleep %d; "
		+ "if [ ! -f %s ]; then "
		+ "  uci import network < %s/network.uci >/dev/null 2>&1 || cp -f %s/network.bak /etc/config/network; "
		+ "  uci commit network >/dev/null 2>&1; "
		+ "  logger -t omniclash-agent 'network change was not confirmed; rolled back'; "
		+ "  /etc/init.d/network reload >/dev/null 2>&1; "
		+ "fi",
		grace, confirm_file, snap, snap);

	/* 把脚本写文件再执行，避免超长单行引号嵌套。
	 *
	 * 注意：OpenWrt 默认不带 nohup，早先用 nohup 起看门狗时进程根本没起来，
	 * 回滚形同虚设。这里改用 start-stop-daemon -b（procd 自带），
	 * 再退回 setsid，两者都能真正脱离 CGI 的生命周期。 */
	let wd_file = '/tmp/omniclash_agent_watchdog.sh';
	writefile(wd_file, "#!/bin/sh\n" + script + "\n");
	shell_exec(sprintf('chmod 755 %s', wd_file));

	let w = popen(sprintf(
		'start-stop-daemon -S -b -x %s 2>/dev/null || (setsid %s >/dev/null 2>&1 &)',
		wd_file, wd_file));
	if (w) w.close();

	return out({
		ok: true,
		applied: true,
		rollback_dir: snap,
		rollback_source: snap_source,
		grace_sec: grace,
		note: 'network reload scheduled; call confirm_network within the grace period or the AP self-restores'
	});
}

function m_confirm_network(p) {
	let q = popen('echo confirmed > /tmp/omniclash_agent_net_ok');
	if (q) q.close();

	/* 本次变更已被接受，清掉"变更前快照"指针，
	 * 避免下一次 apply 误用到这一轮已经过期的快照 */
	unlink(PRECHG_FILE);

	return out({ ok: true, confirmed: true });
}

function m_rollback_network(p) {
	let dir = p.dir;
	if (type(dir) != 'string' || !match(dir, /^\/etc\/omniclash-agent\/snapshots\/[a-zA-Z0-9_-]+$/))
		fail('invalid snapshot dir');

	let f = dir + '/network.uci';
	if (!access(f)) fail('snapshot has no network.uci');

	let q = popen(sprintf('uci import network < %s', f));
	if (q) q.close();

	/* 若 import 失败，退回原始文件副本（更硬的兜底） */
	if (p.hard == true && access(dir + '/network.bak')) {
		let c = popen(sprintf('cp -f %s/network.bak /etc/config/network', dir));
		if (c) c.close();
	}

	let cm = popen('uci commit network');
	if (cm) cm.close();

	let rl = popen('/etc/init.d/network reload >/dev/null 2>&1');
	if (rl) rl.close();

	return out({ ok: true, rolled_back: dir });
}

let body = stdin.read('all') || '';
let req = null;
try { req = json(body); } catch (e) { req = null; }

if (type(req) != 'object')
	fail('malformed request body');
if (type(req.method) != 'string' || !req.method)
	fail('missing method');

let params = (type(req.params) == 'object') ? req.params : {};
let method = req.method;

let expect = token_of();

/* uhttpd 只把 Authorization 等标准头透传给 CGI，自定义 X-* 头会被丢弃，
 * 因此鉴权统一走 Authorization: Bearer <token>（也接受裸 token 便于调试）。 */
function given_token() {
	let h = getenv('HTTP_AUTHORIZATION');
	if (h == null) return null;
	h = trim(sprintf('%s', h));
	let m = match(h, /^[Bb]earer\s+(.+)$/);
	if (m) return trim(m[1]);
	return h;
}

let given = given_token();
let authed = expect ? token_equal(given, expect) : false;

/* ping 允许匿名，但只返回非敏感信息 */
if (method == 'ping') {
	m_ping(params, authed);
	exit(0);
}

if (!expect)
	fail('agent token not initialised');
if (!authed)
	fail('invalid or missing token');

switch (method) {
case 'get_wifi':        m_get_wifi(params); break;
case 'set_wifi':        m_set_wifi(params); break;
case 'bulk_set_wifi':   m_bulk_set_wifi(params); break;
case 'provision_wifi':  m_provision_wifi(params); break;
case 'reload_wifi':     m_reload_wifi(params); break;
case 'restore_wifi':    m_restore_wifi(params); break;
case 'backup_config':   m_backup_config(params); break;
case 'restore_config':  m_restore_config(params); break;
case 'list_snapshots':  m_list_snapshots(params); break;
case 'vlan_status':     m_vlan_status(params); break;
case 'provision_vlan_config': m_provision_vlan_config(params); break;
case 'apply_network':   m_apply_network(params); break;
case 'confirm_network': m_confirm_network(params); break;
case 'rollback_network': m_rollback_network(params); break;
default:
	fail('unknown method: ' + method);
}

exit(0);
