} else if (action == "test_ap") {
    let input_raw = fs.readfile("/dev/stdin") || "";
    let p = {};
    try { p = json(input_raw) || {}; } catch(e) {}

    let host = p.host || ARGV[1] || uci.get("omniclash", "config", "ap_host") || AP_HOST;
    let port = p.port || uci.get("omniclash", "config", "ap_port") || "22";
    let user = p.user || uci.get("omniclash", "config", "ap_user") || "root";
    let pass = p.password || uci.get("omniclash", "config", "ap_password") || "";
    let token = p.token || uci.get("omniclash", "config", "ap_token") || "";
    let key = uci.get("omniclash", "config", "ap_key") || DROPBEAR_KEY;

    /* 优先尝试 agent 通道：只要它能通，就不需要 SSH 凭据 */
    if (token) {
        let old_host = uci.get("omniclash", "config", "ap_host");
        let old_token = uci.get("omniclash", "config", "ap_token");
        /* probe 使用调用方临时给出的 host/token，不落库 */
        let saved_state = _agent_state;
        _agent_state = null;

        let probe_token = token;
        let probe_host = host;
        let req = sprintf('%J', { method: "ping", params: {} });
        fs.writefile("/tmp/omniclash_agent_req.json", req);
        let cmd = sprintf(
            "curl -s -m 5 -X POST -H 'Authorization: Bearer %s' -H 'Content-Type: application/json' --data-binary @/tmp/omniclash_agent_req.json http://%s/cgi-bin/omniclash-agent",
            shq(probe_token), shq(probe_host));
        let pr = shell_exec(cmd);
        let pj = null;
        try { pj = json(trim(pr.out || "")); } catch(e) { pj = null; }

        _agent_state = saved_state;

        if (type(pj) == "object" && pj.ok == true && pj.token_ok == true) {
            print(sprintf("{\"success\":true,\"via\":\"agent\",\"version\":\"%s\",\"msg\":\"子 AP (%s) Agent 通道连通，版本 %s（无需 SSH 凭据）\"}\n",
                pj.version || "?", host, pj.version || "?"));
            return;
        }
    }

    let res = null;
    if (pass) {
        res = shell_exec(sprintf("sshpass -p '%s' dbclient -y -y -p '%s' '%s@%s' 'echo OK' 2>&1", shq(pass), shq(port), shq(user), shq(host)));
    }

    if (!res || !match(res.out, /OK/)) {
        if (fs.access(key)) {
            let key_res = shell_exec(sprintf("dbclient -y -y -p '%s' -i '%s' '%s@%s' 'echo OK' 2>&1", shq(port), shq(key), shq(user), shq(host)));
            if (match(key_res.out, /OK/)) {
                res = key_res;
            }
        }
    }

    if (res && match(res.out, /OK/)) {
        print(sprintf("{\"success\":true,\"msg\":\"子 AP (%s:%s) 连接成功！\"}\n", host, port));
    } else {
        let err_msg = trim((res ? res.out : "") || "连接失败或超时");
        if (!pass && !fs.access(key)) {
            err_msg = "未检测到免密公钥，请在密码框输入子 AP 登录密码后再进行测试或一键配对";
        }
        print(sprintf("{\"success\":false,\"error\":\"无法连接子 AP (%s:%s): %s\"}\n", host, port, err_msg));
    }
} else if (action == "pair_ap") {
    let input_raw = fs.readfile("/dev/stdin") || "";
    let p = {};
    try { p = json(input_raw) || {}; } catch(e) {}

    let host = p.host || ARGV[1] || uci.get("omniclash", "config", "ap_host") || AP_HOST;
    let port = p.port || uci.get("omniclash", "config", "ap_port") || "22";
    let user = p.user || uci.get("omniclash", "config", "ap_user") || "root";
    let pass = p.password || uci.get("omniclash", "config", "ap_password") || "";
    let key = uci.get("omniclash", "config", "ap_key") || DROPBEAR_KEY;

    if (!pass) {
        print("{\"success\":false,\"error\":\"请提供子 AP 的 SSH 登录密码以执行首次公钥配对\"}\n");
    } else {
        if (!fs.access(key)) {
            shell_exec(sprintf("mkdir -p /root/.ssh && dropbearkey -t ed25519 -f '%s' >/dev/null 2>&1", key));
        }

        let pk_res = shell_exec(sprintf("dropbearkey -y -f '%s' | grep '^ssh-'", key));
        let pubkey = trim(pk_res.out || "");
        if (!pubkey) {
            print("{\"success\":false,\"error\":\"无法提取本地 SSH 公钥\"}\n");
        } else {
            let escaped_pub = replace(pubkey, "'", "'\\''");
            let deploy_cmd = sprintf("mkdir -p /etc/dropbear && grep -q -F '%s' /etc/dropbear/authorized_keys 2>/dev/null || echo '%s' >> /etc/dropbear/authorized_keys", escaped_pub, escaped_pub);
            let escaped_deploy = replace(deploy_cmd, "'", "'\\''");

            let dep_res = shell_exec(sprintf("sshpass -p '%s' dbclient -y -y -p '%s' '%s@%s' '%s' 2>&1", shq(pass), shq(port), shq(user), shq(host), escaped_deploy));

            let test_res = shell_exec(sprintf("dbclient -y -y -p '%s' -i '%s' '%s@%s' 'echo OK' 2>&1", shq(port), shq(key), shq(user), shq(host)));
            if (match(test_res.out, /OK/)) {
                uci.set("omniclash", "config", "ap_host", host);
                uci.set("omniclash", "config", "ap_port", port);
                uci.set("omniclash", "config", "ap_user", user);
                uci.commit("omniclash");
                print(sprintf("{\"success\":true,\"msg\":\"🎉 成功与子 AP (%s:%s) 建立 SSH 密钥免密互信！后续将实现毫秒级快速通信。\"}\n", host, port));
            } else {
                print(sprintf("{\"success\":false,\"error\":\"密钥下发后验证失败: %s\"}\n", trim(test_res.out || dep_res.out || "连接超时")));
            }
        }
    }
