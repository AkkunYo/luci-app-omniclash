        uci.set("omniclash", sid, "target", default_target);
        uci.set("omniclash", sid, "disabled", disabled);
        uci.set("omniclash", sid, "ap_section", ap_section);

        push(net_cmds, sprintf("
            uci set network.vlan%s=interface
            uci set network.vlan%s.proto='static'
            uci set network.vlan%s.device='eth1.%s'
            uci set network.vlan%s.ipaddr='192.168.%s.1'
            uci set network.vlan%s.netmask='255.255.255.0'
            uci set dhcp.vlan%s=dhcp
            uci set dhcp.vlan%s.interface='vlan%s'
            uci set dhcp.vlan%s.start='100'
            uci set dhcp.vlan%s.limit='100'
            uci set dhcp.vlan%s.leasetime='12h'
            uci add_list firewall.@zone[0].network='vlan%s' 2>/dev/null
        ", vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan));

        push(ap_cmds, sprintf("
            uci set network.br_vlan%s=device
            uci set network.br_vlan%s.name='br-vlan%s'
            uci set network.br_vlan%s.type='bridge'
            uci add_list network.br_vlan%s.ports='br-lan.%s'
            uci set network.vlan%s=interface
            uci set network.vlan%s.proto='none'
            uci set network.vlan%s.device='br-vlan%s'
            uci set wireless.%s=wifi-iface
            uci set wireless.%s.device='%s'
            uci set wireless.%s.network='vlan%s'
            uci set wireless.%s.mode='ap'
            uci set wireless.%s.ssid='%s'
            uci set wireless.%s.encryption='psk2'
            uci set wireless.%s.key='%s'
            uci set wireless.%s.disabled='%s'
            uci set wireless.%s.wmm='1'
        ", vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan, vlan,
           shq(ap_section), shq(ap_section), shq(radio), shq(ap_section), vlan,
           shq(ap_section), shq(default_ssid), shq(ap_section), shq(default_key),
           shq(ap_section), disabled, shq(ap_section)));
    }

    uci.commit("omniclash");
    shell_exec(join("\n", net_cmds) + "\nuci commit network; uci commit dhcp; uci commit firewall; /etc/init.d/network reload; /etc/init.d/dnsmasq reload; /etc/init.d/firewall reload;");
    wireless_exec(join("\n", ap_cmds) + "\nuci commit network; uci commit wireless; /etc/init.d/network reload; wifi reload;");

    compile_config();
    shell_exec("/usr/bin/omniclash reload >/dev/null 2>&1");
    print("{\"success\":true,\"msg\":\"32满额WiFi全架构常驻初始化完成！\"}\n");
} else if (action == "save_wifi_normal") {
    let input_raw = fs.readfile("/dev/stdin") || "";
    let p = null;
    let parsed_ok = false;
    try { p = json(input_raw); parsed_ok = true; } catch(e) {}
    if (!parsed_ok || type(p) != "object" || type(p.items) != "array") {
        print("{\"success\":false,\"error\":\"标准 WiFi 数据格式非法，必须为数组\"}\n");
        return;
    }
    let items = p.items;

    // 先整体校验再落盘：任何一条缺字段都会写成无效 SSID/密码，
    // 校验失败时保持原文件不动，避免半损坏状态
    for (let item in items) {
        if (type(item) != "object") {
            print("{\"success\":false,\"error\":\"标准 WiFi 数据项必须为对象\"}\n");
            return;
        }
        if (type(item.ssid) != "string" || !item.ssid) {
            print("{\"success\":false,\"error\":\"标准 WiFi 的 SSID 不能为空\"}\n");
            return;
        }
        if (type(item.key) != "string") item.key = "";
    }

    fs.writefile(NORMAL_WIFI_FILE, sprintf("%.J\n", items));

    /* 标准 WiFi 的段可能尚不存在（新 AP 常是纯矩阵配置），
     * 因此这里用 provision 语义做 upsert，而不是 set_wifi（只改已存在段）。 */
    let prov = [];
    for (let item in items) {
        let sec = (item.band == "5g") ? "default_radio1" : "default_radio0";
        let dev = (item.band == "5g") ? "radio1" : "radio0";
        push(prov, {
            section: sec,
            device: dev,
            network: "lan",
            ssid: item.ssid,
            key: item.key,
            disabled: item.disabled ? true : false
        });
    }

    let r = ap_provision_wifi(prov);
    if (!r.ok) {
        print(sprintf("%.J\n", { success: false, error: r.error || "标准 WiFi 下发失败" }));
        return;
    }

    print("{\"success\":true,\"msg\":\"标准普通 WiFi 已成功保存并同步！\"}\n");
} else if (action == "reset_wifi_normal") {
    if (fs.access(NORMAL_WIFI_DEF_FILE)) {
        fs.writefile(NORMAL_WIFI_FILE, fs.readfile(NORMAL_WIFI_DEF_FILE));
    }
    let items = null;
    try { items = json(fs.readfile(NORMAL_WIFI_FILE) || "[]"); } catch(e) { items = null; }
    if (type(items) != "array") items = [];
    let prov = [];
    for (let item in items) {
        if (type(item) != "object" || type(item.ssid) != "string" || !item.ssid) continue;
        let sec = (item.band == "5g") ? "default_radio1" : "default_radio0";
        let dev = (item.band == "5g") ? "radio1" : "radio0";
        push(prov, {
            section: sec,
            device: dev,
            network: "lan",
            ssid: item.ssid,
            key: item.key || "",
            disabled: item.disabled ? true : false
        });
    }
    let r = ap_provision_wifi(prov);
    if (!r.ok) {
        print(sprintf("%.J\n", { success: false, error: r.error || "标准 WiFi 恢复失败" }));
        return;
    }
    print("{\"success\":true,\"msg\":\"标准普通 WiFi 已恢复默认并生效！\"}\n");
} else if (action == "reset_matrix_32") {
    uci.foreach("omniclash", "slot", function(s) {
        uci.delete("omniclash", s[".name"]);
    });
    uci.commit("omniclash");
    let p = fs.popen("/usr/bin/omniclash init_all_32");
    let out = p ? p.read("all") : "";
    if (p) p.close();
    print("{\"success\":true,\"msg\":\"32-WiFi 矩阵已成功重置为全量默认架构！\"}\n");
}
