        push(new_lines, sprintf("%s /usr/bin/omniclash reload >/dev/null 2>&1", cron_time));
    }
    fs.writefile(cron_file, join("\n", new_lines) + "\n");
    shell_exec("/etc/init.d/cron restart");
    print("{\"success\":true,\"msg\":\"定时任务已更新\"}\n");
