} else if (action == "get_matrix") {
    ensure_defaults();
    let slots = get_all_slots();

    let ap_res = ap_exec("
        for s in $(uci show wireless | grep '=wifi-iface' | cut -d. -f2 | cut -d= -f1); do
            ssid=$(uci -q get wireless.$s.ssid)
            key=$(uci -q get wireless.$s.key)
            net=$(uci -q get wireless.$s.network)
            dev=$(uci -q get wireless.$s.device)
            dis=$(uci -q get wireless.$s.disabled || echo 0)
            echo \"$s|$ssid|$key|$net|$dev|$dis\"
        done
        echo '---CLIENTS---'
        for iface in $(iw dev | awk '$1==\"Interface\"{print $2}'); do
            ssid=$(iw dev $iface info 2>/dev/null | awk '$1==\"ssid\"{print $2}')
            cnt=$(iw dev $iface station dump 2>/dev/null | grep -c '^Station' || echo 0)
            echo \"$ssid=$cnt\"
        done
        echo '---LIMITS---'
        for p in phy0 phy1; do
            lim=$(iw phy $p info 2>/dev/null | grep -m1 '#{ AP' | grep -o 'AP.*<= [0-9]*' | grep -o '[0-9]*' || echo 16)
            echo \"$p=$lim\"
        done
    ");

    let ap_blocks = split(ap_res.out, "---CLIENTS---\n");
    let iface_lines = split(ap_blocks[0] || "", "\n");
    let rest_blocks = split(ap_blocks[1] || "", "---LIMITS---\n");
    let client_lines = split(rest_blocks[0] || "", "\n");
    let limit_lines = split(rest_blocks[1] || "", "\n");

    let ap_iface_map = {};
    for (let line in iface_lines) {
        let parts = split(trim(line), "|");
        if (length(parts) >= 5) {
            ap_iface_map[parts[0]] = {
                ssid: parts[1],
                key: parts[2],
                network: parts[3],
                device: parts[4],
                disabled: parts[5] == "1"
            };
        }
    }

    let client_map = {};
    for (let line in client_lines) {
        let parts = split(trim(line), "=");
        if (length(parts) == 2) client_map[parts[0]] = int(parts[1]);
    }

    let limits = { "2g": 16, "5g": 16 };
    for (let line in limit_lines) {
        let parts = split(trim(line), "=");
        if (length(parts) == 2) {
            if (parts[0] == "phy0") limits["2g"] = int(parts[1]);
            else if (parts[0] == "phy1") limits["5g"] = int(parts[1]);
        }
    }

    let cur_res = shell_exec(sprintf("curl -s -H 'Authorization: Bearer %s' %s/proxies", API_SECRET, MIHOMO_API));
    let proxies_json = {};
    try { proxies_json = json(cur_res.out) || {}; } catch(e) {}
    let proxies_map = proxies_json.proxies || {};

    let result_slots = [];
    for (let s in slots) {
        let group_name = sprintf("🌐 %s-出口", s.num);
        let cur_target = s.target;
        if (proxies_map[group_name] && proxies_map[group_name].now) {
            cur_target = proxies_map[group_name].now;
        }

        let real_ssid = s.ssid;
        let real_key = s.key;
        let real_vlan = s.vlan;
        let real_disabled = s.disabled;
        if (s.ap_section && ap_iface_map[s.ap_section]) {
            let info = ap_iface_map[s.ap_section];
            real_ssid = info.ssid || real_ssid;
            real_key = info.key || real_key;
            real_vlan = replace(info.network, "vlan", "");
            real_disabled = info.disabled;
        }

        push(result_slots, {
            sid: s.sid,
            num: s.num,
            band: s.band,
            ssid: real_ssid,
            key: real_key,
            vlan: real_vlan,
            mode: s.mode,
            target: cur_target,
            disabled: real_disabled,
            ap_section: s.ap_section,
            clients: client_map[real_ssid] || 0
        });
    }

    let candidate_names = [
        "🎯 专线-Tallflix", "🎯 专线-Snacky", "🎯 专线-Realith", "🇭🇰 香港节点",
        "🇨🇳 台湾节点", "🇸🇬 新加坡", "🇯🇵 日本节点", "🇺🇲 美国节点", "🇰🇷 韩国",
        "🇬🇧 英国节点", "🇩🇪 德国节点", "🏠 住宅落地", "🚀 节点选择", "♻️ 自动选择",
        "☢ 负载均衡-散列", "☢ 负载均衡-轮询", "🌐 全部节点", "🟢 直连", "🛑 黑洞"
    ];

    let mode = get_run_mode();
    print(sprintf("%.J\n", {
        success: true,
        run_mode: mode,
        ap_host: uci.get("omniclash", "config", "ap_host") || AP_HOST,
        slots: result_slots,
        candidates: candidate_names,
        limits: limits
    }));
} else if (action == "get_dashboard") {
