} else if (action == "get_matrix") {
    ensure_defaults();
    let slots = get_all_slots();

    let ap_iface_map = {};
    let client_map = {};
    let limits = { "2g": 16, "5g": 16 };
    let transport = "local";

    if (is_local_mode()) {
        /* 本机模式直接读本机 uci + iw，无需远端 */
        let snap_res = ap_exec(AP_WIFI_DUMP_CMD);
        let parsed = parse_wifi_dump(snap_res.out || "");
        ap_iface_map = parsed.interfaces;
        client_map = parsed.clients;
        limits = parsed.limits;
    } else {
        let r = ap_get_wifi();
        if (!r.ok) {
            print(sprintf("%.J\n", { success: false, error: r.error || "无法读取子 AP 无线状态" }));
            return;
        }
        transport = r.via;

        if (r.via == "agent") {
            for (let it in (r.data.interfaces || [])) {
                ap_iface_map[it.section] = {
                    ssid: it.ssid,
                    key: it.key,
                    network: it.network,
                    device: it.device,
                    disabled: it.disabled
                };
                if (it.clients > 0) client_map[it.ssid] = it.clients;
            }
            if (r.data.limits) limits = r.data.limits;
        } else {
            let parsed = parse_wifi_dump(r.raw || "");
            ap_iface_map = parsed.interfaces;
            client_map = parsed.clients;
            limits = parsed.limits;
        }
    }

    let cur_res = shell_exec(sprintf("curl -s -H 'Authorization: Bearer %s' %s/proxies", API_SECRET, MIHOMO_API));
    let proxies_json = {};
    try { proxies_json = json(cur_res.out) || {}; } catch(e) {}
    let proxies_map = proxies_json.proxies || {};

    let result_slots = [];
    for (let s in slots) {
        let group_name = sprintf("🌐 %s-出口", s.num);
        let cur_target = s.target;
        if (proxies_map[group_name] && proxies_map[group_name].now) {
            cur_target = proxies_map[group_name].now;
        }

        let real_ssid = s.ssid;
        let real_key = s.key;
        let real_vlan = s.vlan;
        let real_disabled = s.disabled;
        if (s.ap_section && ap_iface_map[s.ap_section]) {
            let info = ap_iface_map[s.ap_section];
            real_ssid = info.ssid || real_ssid;
            real_key = info.key || real_key;
            real_vlan = replace(info.network, "vlan", "");
            real_disabled = info.disabled;
        }

        push(result_slots, {
            sid: s.sid,
            num: s.num,
            band: s.band,
            ssid: real_ssid,
            key: real_key,
            vlan: real_vlan,
            mode: s.mode,
            target: cur_target,
            disabled: real_disabled,
            ap_section: s.ap_section,
            clients: client_map[real_ssid] || 0
        });
    }

    let candidate_names = [
        "🎯 专线-Tallflix", "🎯 专线-Snacky", "🎯 专线-Realith", "🇭🇰 香港节点",
        "🇨🇳 台湾节点", "🇸🇬 新加坡", "🇯🇵 日本节点", "🇺🇲 美国节点", "🇰🇷 韩国",
        "🇬🇧 英国节点", "🇩🇪 德国节点", "🏠 住宅落地", "🚀 节点选择", "♻️ 自动选择",
        "☢ 负载均衡-散列", "☢ 负载均衡-轮询", "🌐 全部节点", "🟢 直连", "🛑 黑洞"
    ];

    let mode = get_run_mode();
    print(sprintf("%.J\n", {
        success: true,
        run_mode: mode,
        ap_host: uci.get("omniclash", "config", "ap_host") || AP_HOST,
        transport: transport,
        agent: (transport == "agent") ? agent_state() : null,
        slots: result_slots,
        candidates: candidate_names,
        limits: limits
    }));
} else if (action == "get_dashboard") {
    let cur_res = shell_exec(sprintf("curl -s -H 'Authorization: Bearer %s' %s/proxies", API_SECRET, MIHOMO_API));
    let p_json = {};
    try { p_json = json(cur_res.out) || {}; } catch(e) {}
    let proxies = p_json.proxies || {};

    let groups = [];
    for (let name in keys(proxies)) {
        let p = proxies[name];
        if (p && (p.type == "Selector" || p.type == "URLTest" || p.type == "Fallback" || p.type == "LoadBalance")) {
            push(groups, {
                name: name,
                type: p.type,
                now: p.now || "",
                all: p.all || []
            });
        }
    }
    sort(groups, function(a, b) {
        if (match(a.name, /专线/) && !match(b.name, /专线/)) return -1;
        if (!match(a.name, /专线/) && match(b.name, /专线/)) return 1;
        if (match(a.name, /出口/) && !match(b.name, /出口/)) return -1;
        if (!match(a.name, /出口/) && match(b.name, /出口/)) return 1;
        return a.name > b.name ? 1 : -1;
    });

    print(sprintf("%.J\n", {
        success: true,
        groups: groups
    }));
