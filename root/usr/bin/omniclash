} else if (action == "save_slot") {
    let input_raw = fs.readfile("/dev/stdin") || "";
    let p = null;
    let parsed_ok = false;
    try { p = json(input_raw); parsed_ok = true; } catch(e) {}
    if (!parsed_ok || type(p) != "object" || type(p.sid) != "string" || !p.sid) {
