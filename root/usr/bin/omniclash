} else if (action == "save_wifi_normal") {
    let input_raw = fs.readfile("/dev/stdin") || "";
    let p = null;
    let parsed_ok = false;
    try { p = json(input_raw); parsed_ok = true; } catch(e) {}
    if (!parsed_ok || type(p) != "object" || type(p.items) != "array") {
        print("{\"success\":false,\"error\":\"标准 WiFi 数据格式非法，必须为数组\"}\n");
        return;
    }
    let items = p.items;
    fs.writefile(NORMAL_WIFI_FILE, sprintf("%.J\n", items));

    for (let item in items) {
        let sec = (item.band == "5g") ? "default_radio1" : "default_radio0";
        wireless_exec(sprintf("
            uci -q set wireless.%s.ssid='%s'
            uci -q set wireless.%s.key='%s'
            uci -q set wireless.%s.disabled='%s'
        ", sec, item.ssid, item.key, item.disabled ? "1" : "0"));
    }
    wireless_exec("uci commit wireless; wifi reload");
    print("{\"success\":true,\"msg\":\"标准普通 WiFi 已成功保存并同步！\"}\n");
} else if (action == "reset_wifi_normal") {
    if (fs.access(NORMAL_WIFI_DEF_FILE)) {
        fs.writefile(NORMAL_WIFI_FILE, fs.readfile(NORMAL_WIFI_DEF_FILE));
    }
    let items = json(fs.readfile(NORMAL_WIFI_FILE) || "[]");
    for (let item in items) {
        let sec = (item.band == "5g") ? "default_radio1" : "default_radio0";
        wireless_exec(sprintf("
            uci -q set wireless.%s.ssid='%s'
            uci -q set wireless.%s.key='%s'
            uci -q set wireless.%s.disabled='%s'
        ", sec, item.ssid, item.key, item.disabled ? "1" : "0"));
    }
    wireless_exec("uci commit wireless; wifi reload");
    print("{\"success\":true,\"msg\":\"标准普通 WiFi 已恢复默认并生效！\"}\n");
} else if (action == "reset_matrix_32") {
    uci.foreach("omniclash", "slot", function(s) {
        uci.delete("omniclash", s[".name"]);
    });
    uci.commit("omniclash");
    let p = fs.popen("/usr/bin/omniclash init_all_32");
    let out = p ? p.read("all") : "";
    if (p) p.close();
    print("{\"success\":true,\"msg\":\"32-WiFi 矩阵已成功重置为全量默认架构！\"}\n");
}
