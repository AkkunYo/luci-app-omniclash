#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/mihomo"
RUN_DIR="/etc/omniclash/run"
CONFIG_FILE="/etc/omniclash/run/config.yaml"
LOG_DIR="/var/log/omniclash"
CORE_LOG="/var/log/omniclash/core.log"
PID_FILE="/var/run/omniclash.pid"
TUN_DEV="omniclash"

setup_firewall() {
	cleanup_firewall
	nft insert rule inet fw4 input iifname "$TUN_DEV" counter accept comment "omniclash" 2>/dev/null || true
	nft insert rule inet fw4 forward oifname "$TUN_DEV" counter accept comment "omniclash" 2>/dev/null || true
	nft insert rule inet fw4 forward iifname "$TUN_DEV" counter accept comment "omniclash" 2>/dev/null || true
}

cleanup_firewall() {
	local handles
	for chain in input forward; do
		handles=$(nft -a list chain inet fw4 "$chain" 2>/dev/null | grep 'comment "omniclash"' | awk '{print $NF}')
		for h in $handles; do
			nft delete rule inet fw4 "$chain" handle "$h" 2>/dev/null || true
		done
	done
}

start_service() {
	local enabled
	config_load omniclash
	config_get_bool enabled "config" "enabled" 1
	[ "$enabled" -eq 1 ] || return 0

	mkdir -p "$RUN_DIR" "$LOG_DIR"

	# 1. 编译生成最新配置并通过语法硬校验
	/usr/bin/omniclash compile >/dev/null 2>&1

	# 2. 使用 exec 启动 Mihomo (避免 /bin/sh 子进程孤儿化导致 stop 杀不掉)
	procd_open_instance omniclash
	procd_set_param command /bin/sh -c "exec $PROG -d $RUN_DIR -f $CONFIG_FILE >> $CORE_LOG 2>&1"
	procd_set_param file "$CONFIG_FILE"
	procd_set_param pidfile "$PID_FILE"
	procd_set_param respawn
	procd_append_param limits nofile="65536 65536"
	procd_close_instance
}

service_started() {
	local timeout=15
	while [ "$timeout" -gt 0 ]; do
		if ip link show dev "$TUN_DEV" >/dev/null 2>&1; then
			break
		fi
		timeout=$((timeout - 1))
		sleep 1
	done
	setup_firewall
}

stop_service() {
	cleanup_firewall
	killall -9 mihomo 2>/dev/null || true
	rm -f "$PID_FILE"
}

reload_service() {
	local enabled
	config_load omniclash
	config_get_bool enabled "config" "enabled" 1
	if [ "$enabled" -eq 0 ]; then
		stop
		return 0
	fi

	/usr/bin/omniclash compile >/dev/null 2>&1
	if pidof mihomo >/dev/null 2>&1; then
		curl -s -X PUT -H "Authorization: Bearer clashclash" -H "Content-Type: application/json" \
			-d "{\"path\":\"$CONFIG_FILE\"}" http://127.0.0.1:9090/configs >/dev/null 2>&1
		setup_firewall
	else
		restart
	fi
}

service_triggers() {
	procd_add_reload_trigger "omniclash" "firewall"
}
